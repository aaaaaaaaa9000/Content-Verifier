# GEMINI_API_KEY: Required. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini model used for verification.
GEMINI_MODEL="gemini-3-flash-preview"

# Optional HTTP Basic Auth. Leave APP_PASSWORD empty to disable it.
APP_USERNAME="user"
APP_PASSWORD=""

# Max /api/verify requests per IP per minute.
RATE_LIMIT_PER_MINUTE=10

# Max characters accepted per verification request.
MAX_INPUT_CHARS=20000

# Server port (default 3000).
PORT=3000

# Public domain used by the Traefik router in docker-compose.yml.
APP_DOMAIN="sadaq.aaaaaaaaa9000.cloud"
